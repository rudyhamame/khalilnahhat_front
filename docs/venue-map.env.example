# FRONTEND (public; rebuild Vite after setting)
# Default commercial-use basemap: no key required.
VITE_VENUE_TILE_PROVIDER=openfreemap
# Optional commercially licensed MapTiler mode:
# VITE_VENUE_TILE_KEY=
# Optional licensed replacement style / OpenMapTiles-compatible infrastructure:
# VITE_VENUE_STYLE_URL=/maps/echo-dark.json
# VITE_VENUE_TILEJSON_URL=https://YOUR-LICENSED-HOST/tiles.json
# VITE_VENUE_GLYPHS_URL=https://YOUR-LICENSED-HOST/fonts/{fontstack}/{range}.pbf

# BACKEND ONLY — never prefix these with VITE_
VENUE_SEARCH_PROVIDER=geoapify
VENUE_SEARCH_API_KEY=
# Use the backend's existing MONGODB_URI and MONGODB_DB_NAME.
