    },
    {
      "text": "فرحتكن",
      "start": 176.22,
      "end": 176.78
    },
    {
      "text": "وتنبسطوا",
      "start": 176.8,
      "end": 177.32
    },
    {
      "text": "مع",
      "start": 177.36,
      "end": 177.46
    },
    {
      "text": "ضيوفكن.",
      "start": 177.54,
      "end": 177.94
    }
  ],
  "cues": [
    {
      "from": 0,
      "to": 6,
      "start": 1.84,
      "end": 4.78,
      "text": "أهلاً وسهلاً فيكن بإيكو لخدمات المناسبات."
    },
    {
      "from": 6,
      "to": 10,
      "start": 5.24,
      "end": 6.66,
      "text": "كل مناسبة إلها قصّة،"
    },
    {
      "from": 10,
      "to": 15,
      "start": 7.08,
      "end": 9.18,
      "text": "وإلها ناسها، وإلها جوّها الخاص."
    },
    {
      "from": 15,
      "to": 22,
      "start": 9.6,
      "end": 13.6,
      "text": "نحنا بإيكو منجمع الموسيقى والصوت والإضاءة والتجهيزات،"
    },
    {
      "from": 22,
      "to": 31,
      "start": 13.82,
      "end": 17.8,
      "text": "ومنرتّب معكن التفاصيل لحتى تطلع مناسبتكن متل ما بتتمنّوا."
    },
    {
      "from": 31,
      "to": 35,
      "start": 18.14,
      "end": 20.14,
      "text": "عرس، خطبة، عيد ميلاد،"
    },
    {
      "from": 35,
      "to": 41,
      "start": 20.38,
      "end": 23.26,
      "text": "تخرّج، حفلة خاصة أو مناسبة لشركتكن…"
    },
    {
      "from": 41,
      "to": 45,
      "start": 23.6,
      "end": 25.44,
      "text": "منساعدكن تختاروا اللي بناسبكن،"
    },
    {
      "from": 45,
      "to": 49,
      "start": 25.7,
      "end": 27.74,
      "text": "بتورونتو ومنطقة تورونتو الكبرى."
    },
    {
      "from": 49,
      "to": 54,
      "start": 28.06,
      "end": 29.44,
      "text": "ومع دي جي خليل نحّات،"
    },
    {
      "from": 54,
      "to": 58,
      "start": 29.64,
      "end": 31.58,
      "text": "الموسيقى بترافقكن بكل لحظة."
    },
    {
      "from": 58,
      "to": 67,
      "start": 31.94,
      "end": 35.22,
      "text": "بخبرة أكتر من عشر سنين بالحفلات العربية واللي بتجمع"
    },
    {
      "from": 67,
      "to": 71,
      "start": 35.28,
      "end": 36.68,
      "text": "ناس من ثقافات مختلفة،"
    },
    {
      "from": 71,
      "to": 79,
      "start": 37.02,
      "end": 40.48,
      "text": "خليل بيحضّر معكن الجوّ الموسيقي حسب ذوقكن وضيوفكن."
    },
    {
      "from": 79,
      "to": 84,
      "start": 40.88,
      "end": 43.38,
      "text": "من استقبال المعازيم، لدخلة العرسان،"
    },
    {
      "from": 84,
      "to": 93,
      "start": 43.64,
      "end": 47.36,
      "text": "لأول رقصة، ولما يولع جوّ الحفلة والكل ينزل عالرقص."
    },
    {
      "from": 93,
      "to": 97,
      "start": 47.8,
      "end": 49.68,
      "text": "فيكن تشاركوه أغانيكن المفضّلة،"
    },
    {
      "from": 97,
      "to": 102,
      "start": 49.96,
      "end": 51.58,
      "text": "والأغاني اللي إلها ذكرى عندكن،"
    },
    {
      "from": 102,
      "to": 107,
      "start": 51.8,
      "end": 53.22,
      "text": "وحتى اللي ما بتحبّوا تنعزف."
    },
    {
      "from": 107,
      "to": 112,
      "start": 53.58,
      "end": 55.72,
      "text": "وإذا بدكن تقديم للحفل وإعلانات،"
    },
    {
      "from": 112,
      "to": 121,
      "start": 55.92,
      "end": 59.52,
      "text": "مننسّقها مع برنامج المناسبة لحتى كل فقرة تجي بوقتها."
    },
    {
      "from": 121,
      "to": 128,
      "start": 59.84,
      "end": 62.98,
      "text": "ولحتى تكتمل الصورة، إيكو بتوفّر أنظمة صوت،"
    },
    {
      "from": 128,
      "to": 136,
      "start": 63.18,
      "end": 67.02,
      "text": "مايكروفونات، إضاءة، شاشات إل إي دي ومؤثرات خاصة."
    },
    {
      "from": 136,
      "to": 141,
      "start": 67.36,
      "end": 69.6,
      "text": "بدكن صوت واضح للكلمات والخطابات؟"
    },
    {
      "from": 141,
      "to": 150,
      "start": 69.88,
      "end": 73.74,
      "text": "إضاءة هادية للاستقبال؟ أو ألوان وحركة ترفع حماس السهرة؟"
    },
    {
      "from": 150,
      "to": 157,
      "start": 74.18,
      "end": 78.1,
      "text": "منساعدكن تختاروا التجهيزات المناسبة للمكان ولنوع المناسبة."
    },
    {
      "from": 157,
      "to": 166,
      "start": 78.32,
      "end": 81.86,
      "text": "وفيكن كمان تستكشفوا خيارات متل الدخان الواطي لأول رقصة،"
    },
    {
      "from": 166,
      "to": 170,
      "start": 82.12,
      "end": 84.38,
      "text": "والشرار البارد، ومؤثرات تانية،"
    },
    {
      "from": 170,
      "to": 176,
      "start": 84.62,
      "end": 87.38,
      "text": "ومننسّق معكن استخدامها حسب المكان وشروطه."
    },
    {
      "from": 176,
      "to": 184,
      "start": 87.72,
      "end": 91.18,
      "text": "وسواء بدكن قطعة معيّنة للإيجار أو مجموعة تجهيزات،"
    },
    {
      "from": 184,
      "to": 188,
      "start": 91.44,
      "end": 92.82,
      "text": "فيكن تختاروا اللي بتحتاجوه."
    },
    {
      "from": 188,
      "to": 192,
      "start": 93.2,
      "end": 94.48,
      "text": "ومن خلال تطبيق إيكو،"
    },
    {
      "from": 192,
      "to": 197,
      "start": 94.74,
      "end": 97.04,
      "text": "فيكن تبلّشوا ترتّبوا أفكاركن براحتكن."
    },
    {
      "from": 197,
      "to": 204,
      "start": 97.32,
      "end": 100.98,
      "text": "بتتصفّحوا الخدمات والمعدات، وبتشوفوا تفاصيل كل خيار،"
    },
    {
      "from": 204,
      "to": 213,
      "start": 101.22,
      "end": 105.34,
      "text": "وبتجرّبوا محاكاة تلاتية الأبعاد بتعطيكن تصوّر مبدئي عن توزيع"
    },
    {
      "from": 213,
      "to": 219,
      "start": 105.4,
      "end": 108.1,
      "text": "التجهيزات بالمكان. هيك بتصير الصورة أوضح،"
    },
    {
      "from": 219,
      "to": 228,
      "start": 108.38,
      "end": 111.88,
      "text": "وبتقدروا تتخيّلوا شكل الإعداد قبل ما تتّفقوا عالتفاصيل مع"
    },
    {
      "from": 228,
      "to": 235,
      "start": 111.92,
      "end": 115.38,
      "text": "الفريق. التطبيق كمان بيساعدكن تشوفوا توفّر الموعد،"
    },
    {
      "from": 235,
      "to": 240,
      "start": 115.6,
      "end": 118.22,
      "text": "وتضيفوا معلومات مناسبتكن، متل نوعها،"
    },
    {
      "from": 240,
      "to": 247,
      "start": 118.32,
      "end": 121.86,
      "text": "ومكانها، وعدد الضيوف، والخدمات اللي حابين تطلبوها."
    },
    {
      "from": 247,
      "to": 256,
      "start": 122.2,
      "end": 126.7,
      "text": "وإذا احتجتوا مساعدة، مساعد إيكو بالذكاء الاصطناعي بيساعدكن تتعرّفوا"
    },
    {
      "from": 256,
      "to": 262,
      "start": 126.72,
      "end": 129.28,
      "text": "عالخيارات، وتلاقوا الأقسام اللي بدكن ياها،"
    },
    {
      "from": 262,
      "to": 266,
      "start": 129.5,
      "end": 131.26,
      "text": "وترتّبوا طلبكن خطوة بخطوة."
    },
    {
      "from": 266,
      "to": 274,
      "start": 131.54,
      "end": 135.46,
      "text": "وبعدها بتتواصلوا مباشرةً مع فريقنا لنراجع التفاصيل سوا،"
    },
    {
      "from": 274,
      "to": 278,
      "start": 135.68,
      "end": 137.04,
      "text": "ونشوف شو الأنسب لإلكن."
    },
    {
      "from": 278,
      "to": 284,
      "start": 137.36,
      "end": 139.84,
      "text": "والحجز بيتثبّت بعد تأكيد إيكو إلكن."
    },
    {
      "from": 284,
      "to": 288,
      "start": 140.2,
      "end": 142.08,
      "text": "ولحتى تتعرّفوا أكتر عأجوائنا،"
    },
    {
      "from": 288,
      "to": 297,
      "start": 142.34,
      "end": 145.86,
      "text": "فيكن تتفرّجوا عالصور، وتقرؤوا تجارب الناس اللي احتفلوا معنا،"
    },
    {
      "from": 297,
      "to": 302,
      "start": 146.1,
      "end": 147.64,
      "text": "وتسمعوا شغل دي جي خليل،"
    },
    {
      "from": 302,
      "to": 311,
      "start": 147.86,
      "end": 152.3,
      "text": "من الميكسات والريمكسات للماش أب والميدلي وإعادة أداء الأغاني"
    },
    {
      "from": 311,
      "to": 318,
      "start": 152.34,
      "end": 155.08,
      "text": "والعروض المباشرة. ولما يكون في بث مباشر،"
    },
    {
      "from": 318,
      "to": 322,
      "start": 155.38,
      "end": 157.38,
      "text": "فيكن تسجّلوا دخول، وتتابعوا،"
    },
    {
      "from": 322,
      "to": 327,
      "start": 157.6,
      "end": 160.46,
      "text": "وتشاركوا بالتعليقات، وتبعتوا طلبات أغانيكن."
    },
    {
      "from": 327,
      "to": 336,
      "start": 160.86,
      "end": 164.44,
      "text": "بالنهاية، نحنا منعرف إنو المناسبة بتعني لإلكن أكتر من"
    },
    {
      "from": 336,
      "to": 342,
      "start": 164.52,
      "end": 167.42,
      "text": "موسيقى وتجهيزات. هي لمّة ناس بتحبّوهن،"
    },
    {
      "from": 342,
      "to": 348,
      "start": 167.74,
      "end": 170.5,
      "text": "ولحظات ناطرينها، وذكريات رح تضلّ معكن."
    },
    {
      "from": 348,
      "to": 352,
      "start": 170.82,
      "end": 172.56,
      "text": "كرمال هيك، منسمع منكن،"
    },
    {
      "from": 352,
      "to": 356,
      "start": 172.78,
      "end": 175.26,
      "text": "ومنرتّب معكن، ومنهتم بالتفاصيل،"
    },
    {
      "from": 356,
      "to": 362,
      "start": 175.48,
      "end": 177.94,
      "text": "لحتى تعيشوا فرحتكن وتنبسطوا مع ضيوفكن."
    }
  ]
}
