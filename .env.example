# Optional overrides; local and LAN browsers use the frontend /api proxy.
# The proxy uses the same live API as Android and the public website.
# Remote hosts default to https://api.djkhalilnahhat.ca/api
# VITE_API_BASE_URL=
# Set after real mailbox delivery is verified; triggers the public contact cutover.
# VITE_PUBLIC_CONTACT_EMAIL=bookings@djkhalilnahhat.ca
# VITE_BOOKING_API_URL=
# VITE_BACKEND_PROXY_TARGET=https://api.djkhalilnahhat.ca
# Opt into an isolated local database only when deliberately testing locally:
# VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:4310

# AI booking and stem routes use OVH by default unless the backend override is set.
# Only set these for deliberate local development:
# VITE_AI_BOOKING_PROXY_TARGET=http://127.0.0.1:4310
# VITE_STEM_PROXY_TARGET=http://127.0.0.1:4310

# Mailbox requests always go to OVH, independently of VITE_BACKEND_PROXY_TARGET.
# This keeps Brevo sending on the fixed server IP (148.113.249.11); authorize that
# IP once in Brevo, rather than authorizing changing home/mobile network IPs.
# Keep the default for real email. Override only for isolated mail-service tests:
# VITE_MAIL_PROXY_TARGET=https://api.djkhalilnahhat.ca
